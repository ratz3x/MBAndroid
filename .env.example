# ============================================================
# Mercedes-Benz Club Indonesia — Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# Supabase Configuration
# Dapatkan dari: https://supabase.com/dashboard → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
EXPO_PUBLIC_APP_NAME=MB Club Indonesia
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENV=development

# Storage Bucket Names (Supabase Storage)
EXPO_PUBLIC_STORAGE_BUCKET_AVATARS=avatars
EXPO_PUBLIC_STORAGE_BUCKET_GALLERY=gallery
EXPO_PUBLIC_STORAGE_BUCKET_DOCUMENTS=documents

# Feature Flags
EXPO_PUBLIC_ENABLE_KOPERASI=true
EXPO_PUBLIC_ENABLE_TOKO=true
EXPO_PUBLIC_ENABLE_FORUM=true
